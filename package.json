{
  "name": "nepal-techguard",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "C:\\xampp\\php\\php.exe -S localhost:8000 backend/router.php",
    "frontend": "cd frontend && npm run dev",
    "start": "npm run dev",
    "db:init": "node scripts/init-db.js",
    "admin:password": "C:\\xampp\\php\\php.exe scripts/set-admin-password.php",
    "build:xampp": "cd frontend && npm run build -- --mode xampp",
    "deploy:xampp": "npm run build:xampp && node scripts/deploy-xampp.js",
    "build:cpanel": "cd frontend && npm run build -- --mode cpanel",
    "deploy:cpanel": "node scripts/deploy-cpanel.js",
    "deploy:cpanel:zip": "node scripts/deploy-cpanel.js --zip-only --zip"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
